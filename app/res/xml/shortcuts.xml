<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/play"
        android:shortcutId="start_clash"
        android:shortcutLongLabel="@string/shortcut_start_clash_long"
        android:shortcutShortLabel="@string/shortcut_start_clash_short">
        <!-- KimiNoBox: explicit target so the shortcut never resolves to upstream YumeBox -->
        <intent
            android:action="com.github.yumeyucca.yumebox.action.START_CLASH"
            android:targetClass="com.github.yumeyucca.yumebox.MainActivity"
            android:targetPackage="io.github.andya1lan.kiminobox"/>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/circle_pause"
        android:shortcutId="stop_clash"
        android:shortcutLongLabel="@string/shortcut_stop_clash_long"
        android:shortcutShortLabel="@string/shortcut_stop_clash_short">
        <!-- KimiNoBox: explicit target so the shortcut never resolves to upstream YumeBox -->
        <intent
            android:action="com.github.yumeyucca.yumebox.action.STOP_CLASH"
            android:targetClass="com.github.yumeyucca.yumebox.MainActivity"
            android:targetPackage="io.github.andya1lan.kiminobox"/>
    </shortcut>
</shortcuts>
